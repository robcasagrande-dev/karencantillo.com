---
interface Props {
  beforeMedia: string;
  afterMedia: string;
  title: string;
  subtitle: string;
  beforeLabel?: string;
  afterLabel?: string;
}

const { 
  beforeMedia, 
  afterMedia, 
  title, 
  subtitle, 
  beforeLabel = "PRIMA", 
  afterLabel = "DOPO" 
} = Astro.props;

const isBeforeVideo = beforeMedia.endsWith('.mp4') || beforeMedia.endsWith('.webm');
const isAfterVideo = afterMedia.endsWith('.mp4') || afterMedia.endsWith('.webm');
---

<div class="before-after-card glass-card">
  <div class="slider-wrapper">
    <!-- After Media (Base) -->
    {isAfterVideo ? (
      <video src={afterMedia} autoplay loop muted playsinline class="media-after" />
    ) : (
      <img src={afterMedia} alt={`${title} - ${afterLabel}`} class="media-after" loading="lazy" />
    )}
    <span class="label label-after">{afterLabel}</span>

    <!-- Before Media (Overlay clipped) -->
    <div class="before-overlay">
      {isBeforeVideo ? (
        <video src={beforeMedia} autoplay loop muted playsinline class="media-before" />
      ) : (
        <img src={beforeMedia} alt={`${title} - ${beforeLabel}`} class="media-before" loading="lazy" />
      )}
      <span class="label label-before">{beforeLabel}</span>
    </div>

    <!-- Drag Handle Slider -->
    <input type="range" min="0" max="100" value="50" class="slider-input" aria-label={`Control ${beforeLabel} & ${afterLabel}`} />
    <div class="slider-line">
      <div class="slider-button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="15 18 9 12 15 6"></polyline>
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </div>
    </div>
  </div>

  <div class="card-info">
    <h4>{title}</h4>
    <p>{subtitle}</p>
  </div>
</div>

<script>
  document.querySelectorAll('.before-after-card').forEach(card => {
    const input = card.querySelector('.slider-input') as HTMLInputElement;
    const overlay = card.querySelector('.before-overlay') as HTMLElement;
    const line = card.querySelector('.slider-line') as HTMLElement;
    const wrapper = card.querySelector('.slider-wrapper') as HTMLElement;
    const mediaBefore = card.querySelector('.media-before') as HTMLElement;

    function updateWidth() {
      if (wrapper && mediaBefore) {
        mediaBefore.style.width = `${wrapper.clientWidth}px`;
      }
    }

    updateWidth();
    window.addEventListener('resize', updateWidth);

    if (input && overlay && line) {
      input.addEventListener('input', (e) => {
        const value = (e.target as HTMLInputElement).value;
        overlay.style.width = `${value}%`;
        line.style.left = `${value}%`;
      });
    }
  });
</script>

<style>
  .before-after-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .slider-wrapper {
    position: relative;
    width: 100%;
    height: 380px;
    overflow: hidden;
    user-select: none;
    background: #000;
  }

  .media-after {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .before-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    overflow: hidden;
    z-index: 2;
    transition: width 0.05s linear;
  }

  .media-before {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Label styling */
  .label {
    position: absolute;
    top: 16px;
    padding: 6px 14px;
    background: rgba(11, 10, 14, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-glass);
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    border-radius: var(--radius-sm);
    z-index: 4;
  }

  .label-before {
    left: 16px;
  }

  .label-after {
    right: 16px;
  }

  /* Range input overlay */
  .slider-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    z-index: 10;
  }

  /* Separator Line & Drag Handle */
  .slider-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: var(--accent-gold);
    z-index: 5;
    pointer-events: none;
    transform: translateX(-50%);
    box-shadow: 0 0 10px rgba(229, 193, 88, 0.5);
  }

  .slider-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 38px;
    height: 38px;
    background: var(--accent-gold);
    color: #0b0a0e;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4), 0 0 0 3px rgba(229, 193, 88, 0.3);
  }

  .card-info {
    padding: 1.5rem;
    background: var(--bg-card);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-info h4 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;

    background: linear-gradient(135deg, #ffffff 0%, var(--accent-gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .card-info p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
