---
import { languages } from '../i18n/translations';

interface Props {
  currentLang: keyof typeof languages;
}

const { currentLang = 'it' } = Astro.props;

const langPaths = {
  it: "/",
  es: "/es/",
  en: "/en/"
};
---

<div class="language-picker glass-card">
  {Object.entries(languages).map(([langKey, langName]) => (
    <a 
      href={langPaths[langKey as keyof typeof langPaths]}
      class={`lang-btn ${currentLang === langKey ? 'active' : ''}`}
      aria-label={`Cambia lingua a ${langName}`}
    >
      {langKey.toUpperCase()}
    </a>
  ))}
</div>

<style>
  .language-picker {
    display: inline-flex;
    align-items: center;
    padding: 3px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-glass);
    background: rgba(11, 10, 14, 0.6);
    backdrop-filter: blur(10px);
  }

  .lang-btn {
    padding: 6px 12px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: var(--radius-full);
    transition: all 0.3s ease;
    letter-spacing: 0.05em;
    min-width: 36px;
    text-align: center;
  }

  .lang-btn:hover {
    color: var(--text-primary);
  }

  .lang-btn.active {
    background: var(--gradient-gold);
    color: #0b0a0e;
    box-shadow: 0 2px 10px rgba(229, 193, 88, 0.3);
  }
</style>
