---
---

<div id="chat-widget-container" class="chat-widget-wrapper">
  <!-- Toggle Button -->
  <button id="chat-toggle-btn" class="chat-toggle-btn" aria-label="Apri chat assistente virtuale">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="pulse-dot"></span>
  </button>

  <!-- Chat Box Modal -->
  <div id="chat-box" class="chat-box glass-card hidden">
    <div class="chat-header">
      <div class="chat-header-title">
        <span class="status-indicator"></span>
        <div>
          <h4>Assistente Karen Cantillo PMU</h4>
          <span class="chat-subtitle">Chiedi info, listino e trattamenti</span>
        </div>
      </div>
      <button id="chat-close-btn" class="chat-close-btn" aria-label="Chiudi chat">&times;</button>
    </div>

    <div id="chat-messages" class="chat-messages">
      <div class="message bot-message">
        <p>✨ Ciao! Sono l'assistente virtuale di <strong>Karen Cantillo PMU</strong> a Roma Monteverde. Come posso aiutarti oggi con l'architettura del tuo sguardo?</p>
      </div>
    </div>

    <form id="chat-form" class="chat-input-area">
      <input 
        type="text" 
        id="chat-input" 
        placeholder="Scrivi qui la tua domanda (es. prezzi extension, patch test...)" 
        required 
        autocomplete="off"
      />
      <button type="submit" id="chat-send-btn" aria-label="Invia messaggio">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById('chat-toggle-btn');
  const closeBtn = document.getElementById('chat-close-btn');
  const chatBox = document.getElementById('chat-box');
  const chatForm = document.getElementById('chat-form') as HTMLFormElement;
  const chatInput = document.getElementById('chat-input') as HTMLInputElement;
  const chatMessages = document.getElementById('chat-messages');

  if (toggleBtn && closeBtn && chatBox) {
    toggleBtn.addEventListener('click', () => chatBox.classList.toggle('hidden'));
    closeBtn.addEventListener('click', () => chatBox.classList.add('hidden'));
  }

  if (chatForm && chatInput && chatMessages) {
    chatForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = chatInput.value.trim();
      if (!text) return;

      const userDiv = document.createElement('div');
      userDiv.className = 'message user-message';
      userDiv.innerHTML = `<p>${text}</p>`;
      chatMessages.appendChild(userDiv);
      chatInput.value = '';
      chatMessages.scrollTop = chatMessages.scrollHeight;

      const botDiv = document.createElement('div');
      botDiv.className = 'message bot-message';
      const p = document.createElement('p');
      p.innerHTML = 'Per informazioni o prenotazioni immediate su WhatsApp: <a href="https://wa.me/393780622421" target="_blank" rel="noopener">+39 378 0622421</a>';
      botDiv.appendChild(p);
      chatMessages.appendChild(botDiv);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    });
  }
</script>

<style>
  .chat-widget-wrapper {
    position: fixed;
    bottom: 95px;
    right: 30px;
    z-index: 98;
  }

  .chat-toggle-btn {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--gradient-gold);
    color: #0b0a0e;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 25px rgba(229, 193, 88, 0.4);
    position: relative;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    min-width: 44px;
    min-height: 44px;
  }

  .chat-toggle-btn:hover {
    transform: scale(1.08);
  }

  .pulse-dot {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 12px;
    height: 12px;
    background: #25d366;
    border-radius: 50%;
    border: 2px solid var(--bg-main);
  }

  .chat-box {
    position: absolute;
    bottom: 70px;
    right: 0;
    width: 360px;
    height: 480px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #14121a;
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
  }

  .chat-box.hidden {
    display: none;
  }

  .chat-header {
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .chat-header-title {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .status-indicator {
    width: 10px;
    height: 10px;
    background: #25d366;
    border-radius: 50%;
  }

  .chat-header h4 {
    font-size: 0.95rem;
    color: var(--text-primary);
    margin: 0;
  }

  .chat-subtitle {
    font-size: 0.75rem;
    color: var(--accent-gold);
  }

  .chat-close-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.5rem;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-messages {
    flex: 1;
    padding: 16px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .message {
    max-width: 85%;
    padding: 12px 16px;
    border-radius: 14px;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .bot-message {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    align-self: flex-start;
    border-bottom-left-radius: 2px;
  }

  .user-message {
    background: var(--gradient-gold);
    color: #0b0a0e;
    align-self: flex-end;
    border-bottom-right-radius: 2px;
    font-weight: 500;
  }

  .chat-input-area {
    padding: 12px 16px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    gap: 10px;
    background: rgba(0, 0, 0, 0.2);
  }

  .chat-input-area input {
    flex: 1;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 10px 16px;
    color: var(--text-primary);
    font-size: 0.85rem;
    outline: none;
  }

  .chat-input-area input:focus {
    border-color: var(--accent-gold);
  }

  .chat-input-area button {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--gradient-gold);
    color: #0b0a0e;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 480px) {
    .chat-widget-wrapper {
      bottom: 85px;
      right: 15px;
    }
    .chat-box {
      width: calc(100vw - 30px);
      right: 0;
      bottom: 65px;
    }
  }
</style>
