---
import Layout from '../layouts/Layout.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import servicesData from '../data/services.json';

const { business, categories } = servicesData;

const beforeAfterCases = [
  {
    beforeImg: "/images/Client1Before.jpg",
    afterImg: "/images/Client1After.jpg",
    title: "Microblading Hiperrealista",
    subtitle: "Definizione e riempimento pelo a pelo adattato alla forma del viso."
  },
  {
    beforeImg: "/images/Client2Before.jpg",
    afterImg: "/images/Client2After.jpg",
    title: "Powder Brows (Efecto Polvo)",
    subtitle: "Sfumatura delicata con effetto makeup naturale e duraturo."
  },
  {
    beforeImg: "/images/Client3Before.jpg",
    afterImg: "/images/Client3After.jpg",
    title: "Ricostruzione & Visagismo",
    subtitle: "Simmetria facciale e ripristino della densità dello sguardo."
  },
  {
    beforeImg: "/images/Client4Before.jpg",
    afterImg: "/images/Client4After.jpg",
    title: "Micropigmentazione Labbra",
    subtitle: "Colorazione naturale e definizione del contorno labiale."
  },
  {
    beforeImg: "/images/Client5Before.jpg",
    afterImg: "/images/Client5After.jpg",
    title: "Correzione Tonalità & Forma",
    subtitle: "Perfezionamento sopracciglia diradate con pigmenti organici."
  },
  {
    beforeImg: "/images/Client6Before.jpg",
    afterImg: "/images/Client6After.jpg",
    title: "Design Integrale Sguardo",
    subtitle: "Armonizzazione estetica completa con tecniche combinate."
  }
];
---

<Layout title="Karen Cantillo PMU | La tua esperta in bellezza sguardo">
  <!-- HERO SECTION -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <span class="section-subtitle">{business.name.toUpperCase()}</span>
        <h1 class="hero-title">
          {business.subtitle.split('bellezza')[0]} <span class="text-gradient">bellezza sguardo</span>
        </h1>
        <p class="hero-description">
          Specialista in <strong>Extension Ciglia</strong>, <strong>Laminazione Ciglia & Sopracciglia</strong>, e <strong>Depilazione Viso</strong> a Monteverde Nuovo, Roma. Valorizza i tuoi tratti naturali con trattamenti personalizzati di alta qualità.
        </p>
        <div class="hero-actions">
          <a href={business.whatsappUrl} class="btn-primary" target="_blank" rel="noopener">
            Prenota su WhatsApp ({business.formattedPhone})
          </a>
          <a href="#servizi" class="btn-secondary">
            Vedi Listino Prezzi
          </a>
        </div>

        <div class="hero-badges">
          <div class="badge-item">
            <span class="badge-number">Roma</span>
            <span class="badge-text">{business.location}</span>
          </div>
          <div class="badge-item">
            <span class="badge-number">Free</span>
            <span class="badge-text">Consulenza Iniziale</span>
          </div>
          <div class="badge-item">
            <span class="badge-number">Instagram</span>
            <span class="badge-text">{business.instagram}</span>
          </div>
        </div>
      </div>

      <div class="hero-media">
        <div class="hero-image-frame glass-card">
          <img src="/images/Client1After.jpg" alt="Karen Cantillo PMU - Bellezza Sguardo" class="hero-img" />
          <div class="hero-image-tag">
            <span class="tag-title">{business.name}</span>
            <span class="tag-sub">Monteverde Nuovo, Roma</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LISTINO PREZZI & SERVIZI (JSON DYNAMIC RENDER) -->
  <section id="servizi" class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">MENÙ TRATTAMENTI</span>
        <h2 class="section-title">Listino Prezzi <span class="text-gradient">Servizi & Beauty</span></h2>
        <p class="section-description">
          Tutti i prezzi ufficiali dei nostri trattamenti per ciglia, sopracciglia e depilazione viso.
        </p>
      </div>

      <div class="pricing-sections">
        {categories.map((cat) => (
          <div class="pricing-category-card glass-card">
            <div class="category-header">
              <h3>{cat.title}</h3>
              <span class="category-subtitle">{cat.subtitle}</span>
              <p class="category-desc">{cat.description}</p>
            </div>

            {cat.id === "extension-ciglia" && (
              <div class="table-responsive">
                <table class="price-table">
                  <thead>
                    <tr>
                      <th>Trattamento</th>
                      <th class="text-center">Primo Impianto</th>
                      <th class="text-center">Ritocco (entro 3 sett.)</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cat.services.map((item) => (
                      <tr>
                        <td class="font-bold">{item.name}</td>
                        <td class="price-cell text-center">€ {item.firstPlantPrice}</td>
                        <td class="price-cell text-center">
                          {item.touchupPrice ? `€ ${item.touchupPrice}` : "—"}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {cat.id === "laminazione-ciglia-sopracciglia" && (
              <div class="table-responsive">
                <table class="price-table">
                  <thead>
                    <tr>
                      <th>Trattamento</th>
                      <th class="text-center">Prezzo</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cat.services.map((item) => (
                      <tr>
                        <td class="font-bold">{item.name}</td>
                        <td class="price-cell text-center">€ {item.price}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {cat.id === "depilazione-viso" && (
              <div class="table-responsive">
                <table class="price-table">
                  <thead>
                    <tr>
                      <th>Area</th>
                      <th class="text-center">Prezzo</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cat.services.map((item) => (
                      <tr>
                        <td class="font-bold">{item.area}</td>
                        <td class="price-cell text-center">€ {item.price}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ANTES Y DESPUÉS / TRANSFORMACIONES -->
  <section id="trasformazioni" class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">GALLERIA LORI</span>
        <h2 class="section-title">Risultati <span class="text-gradient">Prima & Dopo</span></h2>
        <p class="section-description">
          Scorri la barra per confrontare la trasformazione e la cura dei dettagli in ogni cliente.
        </p>
      </div>

      <div class="gallery-grid">
        {beforeAfterCases.map(item => (
          <BeforeAfterSlider 
            beforeImg={item.beforeImg} 
            afterImg={item.afterImg} 
            title={item.title} 
            subtitle={item.subtitle} 
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SECCIÓN DE VIDEOS EN VIVO -->
  <section id="video" class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">IN AZIONE</span>
        <h2 class="section-title">Video <span class="text-gradient">Dimostrativo</span></h2>
        <p class="section-description">
          Guarda da vicino la precisione e il tocco delicato durante le sedute di trattamento.
        </p>
      </div>

      <div class="video-grid">
        <div class="video-card glass-card">
          <video controls poster="/images/ClientInProcess.jpg" class="showcase-video">
            <source src="/videos/ClientVideo1.mp4" type="video/mp4" />
            Il tuo browser non supporta il tag video HTML5.
          </video>
          <div class="video-info">
            <h4>Trattamento in Corso</h4>
            <p>Applicazione accurata per garantire massimo comfort e un effetto naturale.</p>
          </div>
        </div>

        <div class="video-card glass-card">
          <video controls poster="/images/Client7.jpg" class="showcase-video">
            <source src="/videos/ClientVideo2.mp4" type="video/mp4" />
            Il tuo browser non supporta il tag video HTML5.
          </video>
          <div class="video-info">
            <h4>Dettaglio Risultato Finale</h4>
            <p>Sguardo intenso, ordinato e perfettamente definito.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section cta-section">
    <div class="container cta-container glass-card">
      <span class="section-subtitle">PRENOTA ORA</span>
      <h2>Esalta la Bellezza del Tuo Sguardo</h2>
      <p>Per informazioni o per prenotare il tuo trattamento contattaci direttamente su WhatsApp.</p>
      <div class="cta-buttons">
        <a href={business.whatsappUrl} class="btn-primary" target="_blank" rel="noopener">
          Contatta +39 378 0622421
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-section {
    padding: 160px 0 100px;
    position: relative;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-title {
    font-size: 3.8rem;
    margin-bottom: 24px;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--text-secondary);
    margin-bottom: 36px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 20px;
    margin-bottom: 50px;
  }

  .hero-badges {
    display: flex;
    gap: 35px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 30px;
  }

  .badge-item {
    display: flex;
    flex-direction: column;
  }

  .badge-number {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .badge-text {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-image-frame {
    position: relative;
    padding: 12px;
  }

  .hero-img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: var(--radius-md);
    display: block;
  }

  .hero-image-tag {
    position: absolute;
    bottom: 30px;
    left: 30px;
    background: rgba(11, 10, 14, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-glass);
    padding: 12px 20px;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
  }

  .tag-title {
    font-weight: 700;
    color: var(--accent-gold);
    font-size: 0.9rem;
  }

  .tag-sub {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  /* Pricing Sections */
  .pricing-sections {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .pricing-category-card {
    padding: 40px;
  }

  .category-header {
    margin-bottom: 25px;
  }

  .category-header h3 {
    font-size: 2rem;
    color: var(--accent-gold);
    margin-bottom: 4px;
  }

  .category-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-style: italic;
    display: block;
    margin-bottom: 10px;
  }

  .category-desc {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .price-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }

  .price-table th, .price-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-subtle);
    text-align: left;
  }

  .price-table th {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .price-table td {
    color: var(--text-secondary);
    font-size: 1.05rem;
  }

  .font-bold {
    font-weight: 600;
    color: var(--text-primary);
  }

  .price-cell {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem !important;
    color: var(--accent-gold) !important;
  }

  .text-center {
    text-align: center !important;
  }

  /* Gallery Section */
  .section-alt {
    background: rgba(255, 255, 255, 0.015);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 30px;
  }

  /* Video Grid */
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
    gap: 40px;
  }

  .showcase-video {
    width: 100%;
    height: 320px;
    object-fit: cover;
    border-top-left-radius: var(--radius-md);
    border-top-right-radius: var(--radius-md);
    background: #000;
  }

  .video-info {
    padding: 24px;
  }

  .video-info h4 {
    font-size: 1.3rem;
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  .video-info p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  /* CTA Section */
  .cta-container {
    text-align: center;
    padding: 80px 40px;
    max-width: 900px;
    margin: 0 auto;
  }

  .cta-container h2 {
    font-size: 2.8rem;
    margin-bottom: 16px;
  }

  .cta-container p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto 36px;
  }

  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-title {
      font-size: 2.8rem;
    }
    .gallery-grid, .video-grid {
      grid-template-columns: 1fr;
    }
    .pricing-category-card {
      padding: 24px 16px;
    }
  }
</style>
