---
import Layout from '../layouts/Layout.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import servicesData from '../data/services.json';
import { ui } from '../i18n/translations';

const lang = 'it';
const t = ui[lang];

const { business, categories, clinicalSpecs } = servicesData;

const beforeAfterCases = [
  {
    beforeMedia: "/media/Client1Before.jpg",
    afterMedia: "/media/Client1After.jpg",
    title: t.cases[0].title,
    subtitle: t.cases[0].subtitle
  },
  {
    beforeMedia: "/media/Client2Before.jpg",
    afterMedia: "/media/Client2After.jpg",
    title: t.cases[1].title,
    subtitle: t.cases[1].subtitle
  },
  {
    beforeMedia: "/media/Client3Before.jpg",
    afterMedia: "/media/Client3After.jpg",
    title: t.cases[2].title,
    subtitle: t.cases[2].subtitle
  },
  {
    beforeMedia: "/media/Client5Before.jpg",
    afterMedia: "/media/Client5After.jpg",
    title: t.cases[3].title,
    subtitle: t.cases[3].subtitle
  },
  {
    beforeMedia: "/media/Client6Before.jpg",
    afterMedia: "/media/Client6After.jpg",
    title: t.cases[4].title,
    subtitle: t.cases[4].subtitle
  },
  {
    beforeMedia: "/media/ClientXBefore.jpg",
    afterMedia: "/media/ClientXAfter.mp4",
    title: t.cases[5].title,
    subtitle: t.cases[5].subtitle
  },
  {
    beforeMedia: "/media/ClientKBefore.mp4",
    afterMedia: "/media/ClientKAfter.mp4",
    title: t.cases[6].title,
    subtitle: t.cases[6].subtitle
  },
  {
    beforeMedia: "/media/ClientQBefore.mp4",
    afterMedia: "/media/ClientQAfter.mp4",
    title: t.cases[7].title,
    subtitle: t.cases[7].subtitle
  },
  {
    beforeMedia: "/media/ClientWBefore.mp4",
    afterMedia: "/media/ClientWAfter.mp4",
    title: t.cases[8].title,
    subtitle: t.cases[8].subtitle
  },
  {
    beforeMedia: "/media/ClientZBefore.mp4",
    afterMedia: "/media/ClientZAfter.mp4",
    title: t.cases[9].title,
    subtitle: t.cases[9].subtitle
  }
];

const instagramPosts = [
  { image: "/images/Client1After.jpg", title: "Extension Ciglia Classic", likes: "128" },
  { image: "/images/Client2After.jpg", title: "Powder Brows Sfumato", likes: "245" },
  { image: "/images/Client3After.jpg", title: "Visagismo Sopracciglia", likes: "189" },
  { image: "/images/Client4After.jpg", title: "Laminazione Ciglia + Tinta", likes: "312" }
];
---

<Layout lang={lang}>
  <!-- HERO SECTION -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <span class="section-subtitle">{t["hero.subtitle"]}</span>
        <h1 class="hero-title">
          {t["hero.title1"]} <span class="text-gradient">{t["hero.title2"]}</span>
        </h1>
        <p class="hero-description">
          {t["hero.desc"]}
        </p>
        <div class="hero-actions">
          <a href={business.whatsappUrl} class="btn-primary" target="_blank" rel="noopener">
            {t["hero.btn.whatsapp"]} ({business.formattedPhone})
          </a>
          <a href="#servizi" class="btn-secondary">
            {t["hero.btn.prices"]}
          </a>
        </div>

        <div class="hero-badges">
          <div class="badge-item">
            <span class="badge-number">{t["hero.badge1.val"]}</span>
            <span class="badge-text">{t["hero.badge1.lbl"]}</span>
          </div>
          <div class="badge-item">
            <span class="badge-number">{t["hero.badge2.val"]}</span>
            <span class="badge-text">{t["hero.badge2.lbl"]}</span>
          </div>
          <div class="badge-item">
            <span class="badge-number">{t["hero.badge3.val"]}</span>
            <span class="badge-text">{t["hero.badge3.lbl"]}</span>
          </div>
        </div>
      </div>

      <div class="hero-media">
        <div class="hero-image-frame glass-card">
          <img src="/images/Client1After.jpg" alt="Karen Cantillo PMU - Bellezza Sguardo" class="hero-img" />
          <div class="hero-image-tag">
            <span class="tag-title">{business.name}</span>
            <span class="tag-sub">Monteverde Nuovo, Roma</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE SICUREZZA CLINICA & TRASPARENZA -->
  <section id="clinica" class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">{t["clinic.subtitle"]}</span>
        <h2 class="section-title">{t["clinic.title1"]} <span class="text-gradient">{t["clinic.title2"]}</span></h2>
        <p class="section-description">
          {t["clinic.desc"]}
        </p>
      </div>

      <div class="clinical-grid">
        <div class="clinical-card glass-card">
          <div class="card-icon">🛡️</div>
          <h3>{t["clinic.patch.title"]}</h3>
          <p>{t["clinic.patch.desc"]}</p>
          <span class="clinical-tag">{t["clinic.patch.tag"]}</span>
        </div>

        <div class="clinical-card glass-card">
          <div class="card-icon">🧪</div>
          <h3>{t["clinic.chem.title"]}</h3>
          <p>{t["clinic.chem.desc"]}</p>
          <div class="env-specs">
            <span>Temperatura: <strong>{clinicalSpecs.environment.temperatureRange}</strong></span>
            <span>Umidità: <strong>{clinicalSpecs.environment.humidityRange}</strong></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LISTINO PREZZI & CONVERSION FLOW DEDICATO -->
  <section id="servizi" class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">{t["pricing.subtitle"]}</span>
        <h2 class="section-title">{t["pricing.title1"]} <span class="text-gradient">{t["pricing.title2"]}</span></h2>
        <p class="section-description">
          {t["pricing.desc"]}
        </p>
      </div>

      <div class="pricing-sections">
        {categories.map((cat) => (
          <div class="pricing-category-card glass-card">
            <div class="category-header">
              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <h3>{cat.title}</h3>
                <a href={cat.slug} class="btn-secondary" style="padding: 6px 14px; font-size: 0.8rem;">
                  Local SEO Landing &rarr;
                </a>
              </div>
              <span class="category-subtitle">{cat.subtitle}</span>
              <p class="category-desc">{cat.description}</p>
            </div>

            {cat.id === "extension-ciglia" && (
              <div class="table-responsive">
                <table class="price-table">
                  <thead>
                    <tr>
                      <th>{t["pricing.th.treatment"]}</th>
                      <th class="text-center">{t["pricing.th.first"]}</th>
                      <th class="text-center">{t["pricing.th.touchup"]}</th>
                      <th class="text-center">{t["pricing.th.book"]}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cat.services.map((item) => (
                      <tr>
                        <td>
                          <strong class="font-bold">{item.name}</strong>
                          <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">{item.description}</p>
                        </td>
                        <td class="price-cell text-center">€ {item.firstPlantPrice}</td>
                        <td class="price-cell text-center">
                          {item.touchupPrice ? `€ ${item.touchupPrice}` : "—"}
                        </td>
                        <td class="text-center">
                          <a 
                            href={`https://wa.me/${business.whatsappNumber}?text=${encodeURIComponent(item.whatsappText)}`}
                            target="_blank" 
                            rel="noopener"
                            class="btn-primary" 
                            style="padding: 8px 16px; font-size: 0.8rem; min-height: 44px; display: inline-flex;"
                          >
                            {t["pricing.btn.book"]}
                          </a>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {cat.id === "laminazione-ciglia-sopracciglia" && (
              <div class="table-responsive">
                <table class="price-table">
                  <thead>
                    <tr>
                      <th>{t["pricing.th.treatment"]}</th>
                      <th class="text-center">{t["pricing.th.price"]}</th>
                      <th class="text-center">{t["pricing.th.book"]}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cat.services.map((item) => (
                      <tr>
                        <td>
                          <strong class="font-bold">{item.name}</strong>
                          <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">{item.description}</p>
                        </td>
                        <td class="price-cell text-center">€ {item.price}</td>
                        <td class="text-center">
                          <a 
                            href={`https://wa.me/${business.whatsappNumber}?text=${encodeURIComponent(item.whatsappText)}`}
                            target="_blank" 
                            rel="noopener"
                            class="btn-primary" 
                            style="padding: 8px 16px; font-size: 0.8rem; min-height: 44px; display: inline-flex;"
                          >
                            {t["pricing.btn.book"]}
                          </a>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {cat.id === "depilazione-viso" && (
              <div class="table-responsive">
                <table class="price-table">
                  <thead>
                    <tr>
                      <th>{t["pricing.th.area"]}</th>
                      <th class="text-center">{t["pricing.th.price"]}</th>
                      <th class="text-center">{t["pricing.th.book"]}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cat.services.map((item) => (
                      <tr>
                        <td>
                          <strong class="font-bold">{item.area}</strong>
                          <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">{item.description}</p>
                        </td>
                        <td class="price-cell text-center">€ {item.price}</td>
                        <td class="text-center">
                          <a 
                            href={`https://wa.me/${business.whatsappNumber}?text=${encodeURIComponent(item.whatsappText)}`}
                            target="_blank" 
                            rel="noopener"
                            class="btn-primary" 
                            style="padding: 8px 16px; font-size: 0.8rem; min-height: 44px; display: inline-flex;"
                          >
                            {t["pricing.btn.book"]}
                          </a>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ANTES Y DESPUÉS / PRIMA & DOPO TRANSFORMACIONES -->
  <section id="trasformazioni" class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">{t["results.subtitle"]}</span>
        <h2 class="section-title">{t["results.title1"]} <span class="text-gradient">{t["results.title2"]}</span></h2>
        <p class="section-description">
          {t["results.desc"]}
        </p>
      </div>

      <div class="gallery-grid">
        {beforeAfterCases.map(item => (
          <BeforeAfterSlider 
            beforeMedia={item.beforeMedia} 
            afterMedia={item.afterMedia} 
            title={item.title} 
            subtitle={item.subtitle} 
            beforeLabel={t["slider.before"]}
            afterLabel={t["slider.after"]}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SECCIÓN SOCIAL PROOF / DYNAMIC INSTAGRAM FEED -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">{t["social.subtitle"]}</span>
        <h2 class="section-title">{t["social.title1"]} <span class="text-gradient">{t["social.title2"]}</span></h2>
        <p class="section-description">
          {t["social.desc"]} <a href={business.instagramUrl} target="_blank" rel="noopener" style="color: var(--accent-gold);">{business.instagram}</a>
        </p>
      </div>

      <div class="instagram-grid">
        {instagramPosts.map(post => (
          <a href={business.instagramUrl} target="_blank" rel="noopener" class="insta-card glass-card">
            <img src={post.image} alt={post.title} class="insta-img" />
            <div class="insta-overlay">
              <span class="insta-likes">❤️ {post.likes}</span>
              <span class="insta-title">{post.title}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SECCIÓN FAQ / DOMANDE FREQUENTI (LOCAL SEO & RICH SNIPPETS) -->
  <section id="faq" class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">{t["faq.subtitle"]}</span>
        <h2 class="section-title">{t["faq.title1"]} <span class="text-gradient">{t["faq.title2"]}</span></h2>
        <p class="section-description">{t["faq.desc"]}</p>
      </div>

      <div class="faq-grid">
        {t.faqs && t.faqs.map((faq: { q: string; a: string }) => (
          <div class="faq-card glass-card">
            <h3 class="faq-question">❓ {faq.q}</h3>
            <p class="faq-answer">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": t.faqs ? t.faqs.map((faq: { q: string; a: string }) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      })) : []
    })} />
  </section>

  <!-- CTA FINAL -->
  <section class="section cta-section">
    <div class="container cta-container glass-card">
      <span class="section-subtitle">{t["cta.subtitle"]}</span>
      <h2>{t["cta.title"]}</h2>
      <p>{t["cta.desc"]}</p>
      <div class="cta-buttons">
        <a href={business.whatsappUrl} class="btn-primary" target="_blank" rel="noopener">
          {t["cta.btn"]}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-section {
    padding: 160px 0 100px;
    position: relative;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-title {
    font-size: 3.8rem;
    margin-bottom: 24px;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--text-secondary);
    margin-bottom: 36px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 20px;
    margin-bottom: 50px;
  }

  .hero-badges {
    display: flex;
    gap: 35px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 30px;
  }

  .badge-item {
    display: flex;
    flex-direction: column;
  }

  .badge-number {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .badge-text {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-image-frame {
    position: relative;
    padding: 12px;
  }

  .hero-img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: var(--radius-md);
    display: block;
  }

  .hero-image-tag {
    position: absolute;
    bottom: 30px;
    left: 30px;
    background: rgba(11, 10, 14, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-glass);
    padding: 12px 20px;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
  }

  .tag-title {
    font-weight: 700;
    color: var(--accent-gold);
    font-size: 0.9rem;
  }

  .tag-sub {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  /* Clinical Grid */
  .clinical-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  .clinical-card {
    padding: 35px 30px;
  }

  .card-icon {
    font-size: 2.2rem;
    margin-bottom: 16px;
  }

  .clinical-card h3 {
    font-size: 1.5rem;
    color: var(--accent-gold);
    margin-bottom: 12px;
  }

  .clinical-card p {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 16px;
  }

  .clinical-tag {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .env-specs {
    display: flex;
    gap: 20px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 14px;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  /* Pricing Sections */
  .pricing-sections {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .pricing-category-card {
    padding: 40px;
  }

  .category-header {
    margin-bottom: 25px;
  }

  .category-header h3 {
    font-size: 2rem;
    color: var(--accent-gold);
    margin-bottom: 4px;
  }

  .category-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-style: italic;
    display: block;
    margin-bottom: 10px;
  }

  .category-desc {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .price-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }

  .price-table th, .price-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-subtle);
    text-align: left;
  }

  .price-table th {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .price-table td {
    color: var(--text-secondary);
    font-size: 1.05rem;
  }

  .font-bold {
    font-weight: 600;
    color: var(--text-primary);
  }

  .price-cell {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem !important;
    color: var(--accent-gold) !important;
  }

  .text-center {
    text-align: center !important;
  }

  /* Instagram Grid */
  .instagram-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }

  .insta-card {
    position: relative;
    overflow: hidden;
    height: 260px;
    display: block;
    text-decoration: none;
  }

  .insta-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .insta-card:hover .insta-img {
    transform: scale(1.08);
  }

  .insta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(11, 10, 14, 0.65);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .insta-card:hover .insta-overlay {
    opacity: 1;
  }

  .insta-likes {
    color: #ffffff;
    font-weight: 700;
    font-size: 1.1rem;
  }

  .insta-title {
    color: var(--accent-gold);
    font-size: 0.85rem;
  }

  /* Gallery Section */
  .section-alt {
    background: rgba(255, 255, 255, 0.015);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 30px;
  }

  /* FAQ Section */
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  .faq-card {
    padding: 28px;
    border-radius: 16px;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .faq-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-gold);
  }

  .faq-question {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 12px;
    line-height: 1.4;
  }

  .faq-answer {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* CTA Section */
  .cta-container {
    text-align: center;
    padding: 80px 40px;
    max-width: 900px;
    margin: 0 auto;
  }

  .cta-container h2 {
    font-size: 2.8rem;
    margin-bottom: 16px;
  }

  .cta-container p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto 36px;
  }

  @media (max-width: 992px) {
    .hero-container, .clinical-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-title {
      font-size: 2.8rem;
    }
    .gallery-grid {
      grid-template-columns: 1fr;
    }
    .pricing-category-card {
      padding: 24px 16px;
    }
  }
</style>
