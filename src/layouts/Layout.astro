---
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.astro';
import LanguagePicker from '../components/LanguagePicker.astro';
import servicesData from '../data/services.json';
import { ui } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: 'it' | 'es' | 'en';
}

const {
  lang = 'it',
  title,
  description,
  image = "/images/Client1After.jpg"
} = Astro.props;

const t = ui[lang] || ui.it;

const defaultTitle = lang === 'it' 
  ? "Karen Cantillo PMU | L'Architettura dello Sguardo - Roma Monteverde"
  : lang === 'es'
  ? "Karen Cantillo PMU | La Arquitectura de la Mirada - Roma Monteverde"
  : "Karen Cantillo PMU | The Architecture of a Natural Look - Rome Monteverde";

const defaultDesc = lang === 'it'
  ? "Studio specializzato in Extension Ciglia (50€), Laminazione Ciglia & Sopracciglia (30€), Depilazione Viso a Roma Monteverde."
  : lang === 'es'
  ? "Estudio especializado en Extensión de Pestañas (50€), Laminado de Pestañas & Cejas (30€), Depilación Facial en Roma Monteverde."
  : "Specialized studio in Lash Extensions (50€), Lash & Brow Lamination (30€), Threading Facial Hair Removal in Rome Monteverde.";

const pageTitle = title || defaultTitle;
const pageDesc = description || defaultDesc;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://karencantillo.com');
const { business, categories } = servicesData;

// Build Schema.org hasOfferCatalog list
const offerCatalog = {
  "@type": "OfferCatalog",
  "name": "Listino Servizi Karen Cantillo PMU",
  "itemListElement": categories.map(cat => ({
    "@type": "OfferCatalog",
    "name": cat.title,
    "itemListElement": cat.services.map(svc => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": svc.name || svc.area,
        "description": svc.description
      },
      "price": svc.price || svc.firstPlantPrice,
      "priceCurrency": "EUR"
    }))
  }))
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="keywords" content="Karen Cantillo PMU, Extension Ciglia Roma Monteverde, Laminazione Ciglia Roma, Depilazione Filo Arabo Monteverde, Sopracciglia Roma" />
    <meta name="author" content="Karen Cantillo" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDesc} />
    <meta property="twitter:image" content={image} />

    <!-- Schema.org JSON-LD for BeautySalon with GeoCoordinates & offerCatalog -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BeautySalon",
      "name": business.name,
      "image": "https://karencantillo.com/images/Client1After.jpg",
      "url": "https://karencantillo.com",
      "telephone": business.phone,
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Monteverde Nuovo",
        "addressLocality": "Roma",
        "postalCode": "00151",
        "addressCountry": "IT"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": business.geo.latitude,
        "longitude": business.geo.longitude
      },
      "description": business.subtitle,
      "hasOfferCatalog": offerCatalog
    })} />
  </head>
  <body>
    <!-- Navigation Bar -->
    <header class="site-header">
      <div class="container nav-container">
        <a href={lang === 'it' ? '/' : `/${lang}/`} class="logo">
          <span class="logo-name">KAREN CANTILLO</span>
          <span class="logo-sub">PMU & BELLEZZA SGUARDO</span>
        </a>

        <nav class="nav-links">
          <a href={lang === 'it' ? '/#servizi' : `/${lang}/#servizi`}>{t["nav.prices"]}</a>
          <a href={lang === 'it' ? '/#trasformazioni' : `/${lang}/#trasformazioni`}>{t["nav.results"]}</a>
          <a href={lang === 'it' ? '/#clinica' : `/${lang}/#clinica`}>{t["nav.clinic"]}</a>
          <LanguagePicker currentLang={lang} />
          <a href={lang === 'it' ? '/#contatti' : `/${lang}/#contatti`} class="btn-primary nav-btn">{t["nav.contact"]}</a>
        </nav>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main id="inicio">
      <slot />
    </main>

    <!-- Chat Widget Integration -->
    <ChatWidget />

    <!-- Sticky Lower Mobile Contact Bar -->
    <div class="sticky-mobile-bar">
      <a href={`tel:${business.phone}`} class="mobile-bar-btn btn-call" aria-label={t["mobile.call"]}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>{t["mobile.call"]}</span>
      </a>

      <a href={business.whatsappUrl} target="_blank" rel="noopener" class="mobile-bar-btn btn-whatsapp" aria-label={t["mobile.wa"]}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.65zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.572-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>{t["mobile.wa"]}</span>
      </a>
    </div>

    <!-- Footer -->
    <footer id="contatti" class="site-footer">
      <div class="container footer-content">
        <div class="footer-brand">
          <h3>KAREN CANTILLO PMU</h3>
          <p>{business.subtitle}. Trattamenti clinici ed estetici per valorizzare le ciglia e le sopracciglia naturali con la massima precisione.</p>
        </div>
        <div class="footer-links">
          <h4>Navigazione & Servizi</h4>
          <ul>
            <li><a href={lang === 'it' ? '/#servizi' : `/${lang}/#servizi`}>{t["nav.prices"]}</a></li>
            <li><a href="/servizi/extension-ciglia-roma-monteverde">Extension Ciglia Monteverde</a></li>
            <li><a href="/servizi/laminazione-ciglia-roma-monteverde">Laminazione Ciglia & Sopracciglia</a></li>
            <li><a href="/servizi/depilazione-viso-roma-monteverde">Depilazione Viso Filo Arabo</a></li>
            <li><a href={lang === 'it' ? '/#clinica' : `/${lang}/#clinica`}>{t["nav.clinic"]}</a></li>
          </ul>
        </div>
        <div class="footer-contact">
          <h4>Info & Prenotazioni</h4>
          <p>📍 {business.location}</p>
          <p>📞 <a href={`tel:${business.phone}`} style="color: inherit; text-decoration: none;">{business.phone}</a></p>
          <p>📸 Instagram: <a href={business.instagramUrl} target="_blank" rel="noopener" style="color: var(--accent-gold);">{business.instagram}</a></p>
        </div>
      </div>
      <div class="footer-bottom container">
        <p>&copy; {new Date().getFullYear()} Karen Cantillo PMU. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: 20px 0;
    background: rgba(11, 10, 14, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-glass);
    transition: all 0.3s ease;
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }

  .logo-name {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-primary);
  }

  .logo-sub {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    color: var(--accent-gold);
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-links a:not(.btn-primary) {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.3s ease;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .nav-links a:not(.btn-primary):hover {
    color: var(--accent-gold);
  }

  .nav-btn {
    padding: 10px 22px;
    font-size: 0.85rem;
    min-height: 44px;
  }

  /* Sticky Mobile Contact Bar */
  .sticky-mobile-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 999;
    background: #0f0d14;
    border-top: 1px solid var(--border-glass);
    padding: 8px 12px;
    gap: 10px;
    box-shadow: 0 -5px 20px rgba(0, 0, 0, 0.6);
  }

  .mobile-bar-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    border-radius: var(--radius-full);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    min-height: 44px;
    min-width: 44px;
  }

  .btn-call {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
    border: 1px solid var(--border-glass);
  }

  .btn-whatsapp {
    background: #25d366;
    color: #ffffff;
  }

  .site-footer {
    background: #070609;
    border-top: 1px solid var(--border-subtle);
    padding: 80px 0 100px;
    margin-top: 60px;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 50px;
    margin-bottom: 60px;
  }

  .footer-brand h3 {
    font-size: 1.8rem;
    letter-spacing: 0.1em;
    color: var(--accent-gold);
    margin-bottom: 16px;
  }

  .footer-brand p {
    color: var(--text-secondary);
    max-width: 400px;
  }

  .footer-links h4, .footer-contact h4 {
    font-size: 1.1rem;
    color: var(--text-primary);
    margin-bottom: 20px;
    letter-spacing: 0.05em;
  }

  .footer-links ul {
    list-style: none;
  }

  .footer-links li {
    margin-bottom: 12px;
  }

  .footer-links a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.3s ease;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .footer-links a:hover {
    color: var(--accent-gold);
  }

  .footer-contact p {
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 25px;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
    .sticky-mobile-bar {
      display: flex;
    }
    .footer-content {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
